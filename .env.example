# ==============================================================================
# FXENGINE / MT5 INTEGRATION CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DUAL MT5 ACCOUNTS CONFIGURATION (إعدادات حسابي MT5 المربوطين بالبوت)
# ------------------------------------------------------------------------------
# Account 1: Gold Account (حساب الذهب المخصص لصفقات وتحليلات الذهب)
MT5_MIRROR_LOGIN_GOLD=8058543
MT5_MIRROR_SERVER_GOLD=SCFMLimited-Demo2
MT5_MIRROR_INVESTOR_PASSWORD_GOLD=

# Account 2: Forex Account (حساب الفوركس المخصص لصفقات وتحليلات العملات)
MT5_MIRROR_LOGIN_FOREX=160767360
MT5_MIRROR_SERVER_FOREX=SCFMLimited-Demo2
MT5_MIRROR_INVESTOR_PASSWORD_FOREX=

# General / Single Account Watcher (الحساب الأساسي للمراقبة إذا رغبت بحساب واحد)
MT5_MIRROR_LOGIN=0
MT5_MIRROR_SERVER=
MT5_MIRROR_INVESTOR_PASSWORD=
MIRROR_ALLOW_LIVE=true

# ------------------------------------------------------------------------------
# 2. TELEGRAM BROADCASTING CONFIGURATION (إرسال التحليلات والصفقات لجروبات تليجرام)
# ------------------------------------------------------------------------------
# طريقة 1: الإرسال المباشر عبر تليجرام بوت (Direct Telegram Bot API)
# احصل على التوكن من @BotFather وضع معرفات الجروبات هنا (مثل: -1001234567890 أو @group_username)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_GOLD=        # معرف جروب تليجرام المخصص لصفقات وتحليلات الذهب
TELEGRAM_CHAT_ID_FOREX=       # معرف جروب تليجرام المخصص لصفقات وتحليلات الفوركس
TELEGRAM_CHAT_ID_INDEX=       # معرف جروب تليجرام للمؤشرات والسلع والعملات الرقمية (اختياري)

# طريقة 2: عبر N8N Webhooks (إذا كنت تستخدم سيرفر n8n وسيط)
N8N_ENABLED=false
N8N_WEBHOOK_URL_GOLD=
N8N_WEBHOOK_URL_FOREX=
N8N_WEBHOOK_URL_INDEX=
N8N_WEBHOOK_URL=

# مفاتيح النشر عبر تليجرام (Telegram Publishing Switches)
TELEGRAM_DRY_RUN=false                 # اضبطه على false للنشر الحي الفعلي على التليجرام
TELEGRAM_PUBLISH_MODEL_SIGNALS=true    # نشر إشارات وتحليلات نماذج الذكاء الاصطناعي
TELEGRAM_PUBLISH_TRADES=true           # نشر الصفقات المفتوحة
TELEGRAM_PUBLISH_RESULTS=true          # نشر نتائج الصفقات عند إغلاقها (أرباح/خسائر)
TELEGRAM_PUBLISH_DESK=true             # نشر صفقات لوحة التداول اليدوي
MIRROR_PUBLISH_TELEGRAM=true           # نشر صفقات MT5 المنسوخة
MIRROR_PUBLISH_GOLD=true               # تفعيل نشر صفقات الذهب

# استثناءات الرموز (اتركه فارغاً للسماح لجميع الرموز بالبث على تليجرام)
TELEGRAM_EXCLUDED_SYMBOLS=

# ------------------------------------------------------------------------------
# 3. DASHBOARDS SECURITY (كلمات مرور لوحات التحكم)
# ------------------------------------------------------------------------------
MIRROR_UI_PASSWORD=fx_mirror_sec_2026_ab81c
ANALYST_DESK_PASSWORD=fx_desk_sec_2026_99a8b

# ------------------------------------------------------------------------------
# 4. SYSTEM SWITCHES
# ------------------------------------------------------------------------------
ENABLE_AUTONOMOUS_TRADING=false
AUTONOMOUS_TRADING_ENABLED=false
